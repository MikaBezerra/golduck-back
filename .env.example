# Modelo do .env local (desenvolvimento). Copie para .env e ajuste; o .env não é versionado.
# Os ambientes develop e production ficam em .env.develop e .env.production, criptografados com dotenvx.

# API configuration
# Nome do ambiente: aparece nos logs e em GET /api/version (local, develop, production...).
APP_ENV=local
API_PORT=3000
API_PREFIX=/api
# Origens liberadas no CORS, separadas por vírgula (ex.: https://golduck.vercel.app).
# Vazio mantém o CORS desligado; em desenvolvimento o front usa o proxy do Angular.
API_CORS_ORIGINS=
# 1 publica a documentação OpenAPI em /docs (interface) e /docs-json (JSON).
# O front gera os tipos a partir de /docs-json. Use 0 (ou vazio) em produção.
SWAGGER_ENABLE=1
# Em quais proxies confiar para obter o IP real do cliente (X-Forwarded-For).
# Vazio/false = nenhum (acesso direto); true = todos (ex.: Vercel); número = saltos; ou IPs/CIDRs separados por vírgula.
TRUST_PROXY=

# Database ORM configuration (Postgres do docker-compose, na porta 5433)
DATABASE_URL=postgresql://mikaell:password@localhost:5433/financas?schema=public

# JWT configuration
# Segredo com pelo menos 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_ISSUER=IssuerApplication

# Logs
# Nível mínimo: error, warn, info ou debug (debug mostra também as consultas ao banco e o log interno do Nest).
LOG_LEVEL=info
# pretty (legível, colorido) ou json (uma linha por evento). Vazio: pretty com APP_ENV=local, json nos demais.
LOG_FORMAT=
# Corpo de POST/PUT/PATCH/DELETE no log: off, errors (só nas requisições que falharam) ou all.
# Senhas, tokens e segredos são sempre ocultados; uploads (multipart) nunca são registrados.
LOG_REQUEST_BODY=errors
# A partir de quantos ms uma requisição / consulta ao banco é registrada como lenta (warn).
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500
# Commit publicado (aparece nos logs e em /api/version). Na Vercel vem sozinho em VERCEL_GIT_COMMIT_SHA.
GIT_COMMIT_SHA=
