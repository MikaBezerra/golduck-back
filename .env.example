# API configuration
API_PORT=3000
API_PREFIX=/api
# Origens liberadas no CORS, separadas por vírgula (ex.: https://financas.vercel.app).
# Vazio mantém o CORS desligado; em desenvolvimento o front usa o proxy do Angular.
API_CORS_ORIGINS=

# Database ORM configuration
DATABASE_URL=postgresql://mikaell:password@localhost:5433/financas?schema=public

# JWT configuration
JWT_SECRET=ThisMustBeChanged
JWT_ISSUER=IssuerApplication

# Domain-related configuration
PASSENGERS_ALLOWED=yes
