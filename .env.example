# Modelo do .env local: copie para .env e ajuste. Cada variável está explicada em docs/ambiente-e-configuracao.md.

# Ambiente
APP_ENV=local
GIT_COMMIT_SHA=

# API
API_PORT=3000
API_PREFIX=/api
# Origens do front, separadas por vírgula (CORS com cookies e login/refresh/logout). Vazio desliga o CORS.
API_CORS_ORIGINS=http://localhost:4200
SWAGGER_ENABLE=1
# Vazio = acesso direto; true = atrás de proxy (Vercel); também aceita número de saltos ou IPs/CIDRs.
TRUST_PROXY=

# Banco (Postgres do docker-compose, porta 5433). ?schema= escolhe o schema.
DATABASE_URL=postgresql://mikaell:password@localhost:5433/financas?schema=public
# Conexão direta só para as migrações (no Neon, o endereço sem -pooler). Vazio = usa a DATABASE_URL.
DATABASE_DIRECT_URL=

# Autenticação
# Mínimo de 32 caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_ISSUER=IssuerApplication
AUTH_COOKIE_NAME=golduck_refresh
AUTH_COOKIE_SAMESITE=strict
AUTH_COOKIE_DOMAIN=

# Logs
LOG_LEVEL=info
LOG_FORMAT=
LOG_REQUEST_BODY=errors
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=500

# Sincronização dos cartões com o Meu Pluggy (Client ID e Secret do Pluggy Dashboard). Vazio = sincronização desligada.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_API_URL=https://api.pluggy.ai

# Chave da rotina diária da Vercel (GET /api/card-sync/cron), com 16 caracteres ou mais. Vazio = rota recusada.
CRON_SECRET=
