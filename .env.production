DOTENV_PUBLIC_KEY_PRODUCTION="022be8ad39a7cdc9b86949b39a266c481941e173bc5d6193822752ac6d081410ff"

# .env.production
# Ambiente production. Arquivo versionado: os valores sensíveis ficam criptografados pelo dotenvx.
# A chave privada (DOTENV_PRIVATE_KEY_PRODUCTION) fica no .env.keys local e nos secrets do GitHub,
# nunca no repositório. Para trocar um valor: npx dotenvx set NOME "valor" -f .env.production
# (use --plain para valores não sensíveis, como API_PORT).

API_PORT=3000
API_PREFIX=/api
# Domínio do front publicado; vazio mantém o CORS desligado (front e API no mesmo domínio via rewrite).
API_CORS_ORIGINS=
SWAGGER_ENABLE=0

