{
  "moduleFileExtensions": [
    "ts",
    "js",
    "mjs",
    "json"
  ],
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true,
        "tsconfig": "tsconfig.spec.json"
      }
    ]
  },
  "testEnvironment": "node",
  "testRegex": "/src/.*\\.(test|spec)\\.ts$",
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/generated/**",
    "!**/node_modules/**"
  ],
  "coverageReporters": [
    "json",
    "lcov"
  ]
}
