{
  "name": "golduck-back",
  "version": "0.1.0",
  "description": "API do Golduck, app de finanças pessoais (NestJS + Fastify + Prisma)",
  "author": "Mikaell Silva",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "start": "node dist/server.js",
    "start:develop": "dotenvx run -f .env.develop -- node dist/server.js",
    "start:production": "dotenvx run -f .env.production -- node dist/server.js",
    "dev": "prisma generate && dotenvx run -f .env -- node scripts/dev.mjs",
    "admin:create": "prisma generate && dotenvx run -f .env -- tsx scripts/create-admin.ts",
    "admin:create:develop": "prisma generate && dotenvx run -f .env.develop -- tsx scripts/create-admin.ts",
    "admin:create:production": "prisma generate && dotenvx run -f .env.production -- tsx scripts/create-admin.ts",
    "build": "prisma generate && npm run clean && tsc",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.eslint.json",
    "test": "prisma generate && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config=jest.json",
    "test:cov": "prisma generate && node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config=jest.json --coverage",
    "db:check": "prisma migrate status && prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "verify": "prisma generate && npm run lint:check && npm run typecheck && npm run test:cov && npm run build && npm run db:check",
    "lint": "eslint -c .eslintrc.cjs --fix --ext .ts src",
    "lint:check": "eslint -c .eslintrc.cjs --ext .ts src --max-warnings=0",
    "db:migrate:develop": "dotenvx run -f .env.develop -- prisma migrate deploy",
    "db:migrate:production": "dotenvx run -f .env.production -- prisma migrate deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@inquirer/prompts": "^8.7.4",
    "@jest/globals": "^30.5.2",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@jest/reporters": {
      "glob": "^14.0.4"
    },
    "jest-config": {
      "glob": "^14.0.4"
    },
    "jest-runtime": {
      "glob": "^14.0.4"
    },
    "test-exclude": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
