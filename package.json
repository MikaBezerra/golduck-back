{
  "name": "nest-template",
  "version": "0.1.0",
  "description": "NestJS API project template crafted for Docker environments",
  "author": "Saluki",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "start": "node dist/server.js",
    "dev": "prisma generate && env-cmd -f .env -- node --watch -r ts-node/register/transpile-only src/server.ts",
    "admin:create": "prisma generate && env-cmd -f .env tsx scripts/create-admin.ts",
    "build": "prisma generate && npm run clean && tsc",
    "test": "prisma generate && env-cmd -f .env jest --config=jest.json",
    "lint": "eslint -c .eslintrc.js --fix --ext .ts src"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@nestjs/testing": "^12.2.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "env-cmd": "^11.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
