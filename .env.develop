DOTENV_PUBLIC_KEY_DEVELOP="03190f4d1a6d26bced8ab6f4bb01c487f648e845be9197fe29479ddf557f432bc1"

# .env.develop
# Ambiente develop. Arquivo versionado: os valores sensíveis ficam criptografados pelo dotenvx.
# A chave privada (DOTENV_PRIVATE_KEY_DEVELOP) fica no .env.keys local e nos secrets do GitHub,
# nunca no repositório. Para trocar um valor: npx dotenvx set NOME "valor" -f .env.develop
# (use --plain para valores não sensíveis, como API_PORT).

API_PORT=3000
API_PREFIX=/api
# Domínio do front publicado; vazio mantém o CORS desligado (front e API no mesmo domínio via rewrite).
API_CORS_ORIGINS=
SWAGGER_ENABLE=1

