// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  role         Role          @default(USER)
  active       Boolean       @default(true)
  hash         String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  authSessions AuthSession[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Person {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  email          String?         @db.VarChar(254)
  phone          String?         @db.VarChar(16)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  manualExpenses ManualExpense[]
  cardExpenses   CardExpense[]

  @@index([active, name])
}

model Category {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  nameKey        String          @unique @db.VarChar(120)
  active         Boolean         @default(true)
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  manualExpenses ManualExpense[]
  cardExpenses   CardExpense[]

  @@index([active, name])
}

model MonthlyIncome {
  id          String   @id @default(uuid()) @db.Uuid
  month       DateTime @unique @db.Date
  amountCents BigInt   @db.BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// Reserva do mês: quanto foi guardado. No resumo, conta como um gasto compartilhado.
model MonthlyReserve {
  id          String   @id @default(uuid()) @db.Uuid
  month       DateTime @unique @db.Date
  amountCents BigInt   @db.BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model ManualExpense {
  id          String   @id @default(uuid()) @db.Uuid
  month       DateTime @db.Date
  title       String   @db.VarChar(160)
  amountCents BigInt   @db.BigInt
  categoryId  String   @db.Uuid
  personId    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  person   Person?  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([month])
  @@index([categoryId])
  @@index([personId])
}

model CreditCard {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(120)
  bank      CardBank
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
  imports   CardImport[]
  expenses  CardExpense[]

  @@index([active, name])
}

model CardImport {
  id            String   @id @default(uuid()) @db.Uuid
  cardId        String   @db.Uuid
  month         DateTime @db.Date
  fileName      String   @db.VarChar(255)
  fileHash      String   @db.VarChar(64)
  parserVersion String   @db.VarChar(40)
  rowCount      Int
  ignoredCount  Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  card     CreditCard    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  expenses CardExpense[]

  @@index([cardId, month])
}

model CardExpense {
  id                  String    @id @default(uuid()) @db.Uuid
  cardId              String    @db.Uuid
  importId            String    @db.Uuid
  month               DateTime  @db.Date
  sourceMonth         DateTime  @db.Date
  purchaseKey         String    @db.VarChar(320)
  transactionDate     DateTime  @db.Date
  originalDescription String    @db.VarChar(200)
  holderName          String?   @db.VarChar(120)
  cardLastDigits      String?   @db.VarChar(4)
  amountCents         BigInt    @db.BigInt
  installmentNumber   Int?
  installmentTotal    Int?
  nickname            String?   @db.VarChar(160)
  categoryId          String    @db.Uuid
  personId            String?   @db.Uuid
  /// Exclusão suave: a linha sai das listas e dos totais, e os uploads a mantêm excluída.
  excludedAt          DateTime? @db.Timestamptz(3)
  /// "Não perguntar de novo" quando a compra excluída reaparece num upload.
  exclusionRemembered Boolean   @default(false)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  card     CreditCard @relation(fields: [cardId], references: [id], onDelete: Restrict)
  import   CardImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  person   Person?    @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([cardId, month, purchaseKey])
  @@index([cardId, purchaseKey])
  @@index([month])
  @@index([importId])
  @@index([categoryId])
  @@index([personId])
}

enum CardBank {
  NUBANK
  C6
  NEON
}

enum Role {
  ADMIN
  USER
}
