// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  role         Role          @default(USER)
  active       Boolean       @default(true)
  hash         String
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  authSessions AuthSession[]
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Person {
  id             String                @id @default(uuid()) @db.Uuid
  name           String                @db.VarChar(120)
  email          String?               @db.VarChar(254)
  phone          String?               @db.VarChar(16)
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  manualExpenses ManualExpense[]
  cardExpenses   CardExpense[]
  dispatchItems  SummaryDispatchItem[]

  @@index([active, name])
}

model Category {
  id             String          @id @default(uuid()) @db.Uuid
  name           String          @db.VarChar(120)
  nameKey        String          @unique @db.VarChar(120)
  active         Boolean         @default(true)
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  manualExpenses ManualExpense[]
  cardExpenses   CardExpense[]

  @@index([active, name])
}

model MonthlyIncome {
  id          String   @id @default(uuid()) @db.Uuid
  month       DateTime @unique @db.Date
  amountCents BigInt   @db.BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

/// Reserva do mês: quanto foi guardado. No resumo, conta como um gasto compartilhado.
model MonthlyReserve {
  id          String   @id @default(uuid()) @db.Uuid
  month       DateTime @unique @db.Date
  amountCents BigInt   @db.BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model ManualExpense {
  id          String       @id @default(uuid()) @db.Uuid
  month       DateTime     @db.Date
  title       String       @db.VarChar(160)
  amountCents BigInt       @db.BigInt
  categoryId  String       @db.Uuid
  /// Nunca PENDING: quem lança a despesa à mão escolhe na hora.
  split       ExpenseSplit
  /// Preenchido só quando split = PERSONAL (CHECK no banco).
  personId    String?      @db.Uuid
  /// Quando o usuário marcou a despesa como paga; null = não paga.
  paidAt      DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  person   Person?  @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([month])
  @@index([categoryId])
  @@index([personId])
}

model CreditCard {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String                   @db.VarChar(120)
  bank                 CardBank
  active               Boolean                  @default(true)
  /// Dia do vencimento (1 a 31): a fatura recebe o nome do mês em que vence.
  dueDay               Int?
  /// Melhor dia de compra padrão: compras a partir dele vão para a fatura seguinte.
  bestPurchaseDay      Int?
  /// Limite do cartão, informado pelo usuário: base do limite disponível no resumo das faturas.
  creditLimitCents     BigInt?                  @db.BigInt
  /// Item (a conexão de um banco) no Meu Pluggy.
  pluggyItemId         String?                  @db.Uuid
  /// Conta de cartão de crédito dentro do item, descoberta na primeira sincronização.
  pluggyAccountId      String?                  @db.VarChar(64)
  /// Primeira fatura (mês) controlada pela sincronização; as anteriores ficam como estão.
  syncFromMonth        DateTime?                @db.Date
  /// Fim da última sincronização que deu certo.
  syncedAt             DateTime?                @db.Timestamptz(3)
  /// Última atualização dos dados na Pluggy (lastUpdatedAt do item).
  syncDataUpdatedAt    DateTime?                @db.Timestamptz(3)
  /// Situação do item na Pluggy (UPDATED, LOGIN_ERROR...).
  syncStatus           String?                  @db.VarChar(40)
  /// Erro da última tentativa; null quando ela deu certo.
  syncError            String?                  @db.VarChar(300)
  /// Fim da autorização do Open Finance (renovada no Meu Pluggy).
  syncConsentExpiresAt DateTime?                @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  imports              CardImport[]
  expenses             CardExpense[]
  bills                CardBill[]
  corrections          CardPurchaseCorrection[]

  @@index([active, name])
}

/// Uma fatura do cartão (mês do vencimento): o melhor dia ajustado pelo usuário e as datas informadas pelo banco.
model CardBill {
  id               String    @id @default(uuid()) @db.Uuid
  cardId           String    @db.Uuid
  month            DateTime  @db.Date
  /// Melhor dia de compra desta fatura, informado pelo usuário (vale sobre o padrão do cartão).
  bestPurchaseDate DateTime? @db.Date
  /// Fechamento informado pelo banco depois que a fatura fecha (vale sobre tudo).
  bankClosingDate  DateTime? @db.Date
  bankDueDate      DateTime? @db.Date
  /// Quando o usuário marcou a fatura (fechada) como paga; null = não paga.
  paidAt           DateTime? @db.Timestamptz(3)
  /// Total da fatura no momento do pagamento: se a fatura mudar depois, o app avisa.
  paidAmountCents  BigInt?   @db.BigInt
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, month])
}

/// Correção do usuário: a parcela installmentNumber da compra fica em month, e as outras seguem a partir dela.
model CardPurchaseCorrection {
  id                String   @id @default(uuid()) @db.Uuid
  cardId            String   @db.Uuid
  purchaseKey       String   @db.VarChar(320)
  installmentNumber Int
  installmentTotal  Int?
  month             DateTime @db.Date
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  card CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, purchaseKey])
}

model CardImport {
  id            String   @id @default(uuid()) @db.Uuid
  cardId        String   @db.Uuid
  month         DateTime @db.Date
  fileName      String   @db.VarChar(255)
  fileHash      String   @db.VarChar(64)
  parserVersion String   @db.VarChar(40)
  rowCount      Int
  ignoredCount  Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  card     CreditCard    @relation(fields: [cardId], references: [id], onDelete: Restrict)
  expenses CardExpense[]

  @@index([cardId, month])
}

model CardExpense {
  id                  String            @id @default(uuid()) @db.Uuid
  cardId              String            @db.Uuid
  /// Upload que gravou a linha por último; null nas linhas sincronizadas ou lançadas à mão.
  importId            String?           @db.Uuid
  origin              CardExpenseOrigin @default(UPLOAD)
  /// Id da transação na Pluggy (linhas sincronizadas).
  externalId          String?           @db.VarChar(64)
  month               DateTime          @db.Date
  sourceMonth         DateTime          @db.Date
  purchaseKey         String            @db.VarChar(320)
  transactionDate     DateTime          @db.Date
  originalDescription String            @db.VarChar(200)
  holderName          String?           @db.VarChar(120)
  cardLastDigits      String?           @db.VarChar(4)
  amountCents         BigInt            @db.BigInt
  installmentNumber   Int?
  installmentTotal    Int?
  nickname            String?           @db.VarChar(160)
  categoryId          String            @db.Uuid
  /// PENDING até alguém escolher a pessoa (ou compartilhada); parcelas novas herdam da compra.
  split               ExpenseSplit
  /// Preenchido só quando split = PERSONAL (CHECK no banco).
  personId            String?           @db.Uuid
  /// Exclusão suave: a linha sai das listas e dos totais, e os uploads a mantêm excluída.
  excludedAt          DateTime?         @db.Timestamptz(3)
  /// "Não perguntar de novo" quando a compra excluída reaparece num upload.
  exclusionRemembered Boolean           @default(false)
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  card     CreditCard  @relation(fields: [cardId], references: [id], onDelete: Restrict)
  import   CardImport? @relation(fields: [importId], references: [id], onDelete: Cascade)
  category Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  person   Person?     @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([cardId, month, purchaseKey])
  @@index([cardId, purchaseKey])
  @@index([month])
  @@index([importId])
  @@index([categoryId])
  @@index([personId])
  @@index([month, split])
}

/// Um envio do resumo do mês (botão "Enviar por e-mail"), com o resultado de cada pessoa.
model SummaryDispatch {
  id             String                @id @default(uuid()) @db.Uuid
  month          DateTime              @db.Date
  channel        SummaryChannel        @default(EMAIL)
  status         SummaryDispatchStatus @default(RUNNING)
  /// Preenchido só enquanto o envio roda: o índice único impede dois envios do mesmo mês ao mesmo tempo.
  runningMonth   DateTime?             @unique @db.Date
  /// Header Idempotency-Key: a mesma chave devolve o resultado gravado, sem enviar de novo.
  idempotencyKey String                @unique @db.VarChar(64)
  startedAt      DateTime              @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?             @db.Timestamptz(3)
  items          SummaryDispatchItem[]

  @@index([month, startedAt])
}

model SummaryDispatchItem {
  id         String                    @id @default(uuid()) @db.Uuid
  dispatchId String                    @db.Uuid
  personId   String                    @db.Uuid
  /// Nome da pessoa no momento do envio.
  name       String                    @db.VarChar(120)
  /// Destinatário mascarado (ay•••@gmail.com); null quando a pessoa não tem e-mail.
  recipient  String?                   @db.VarChar(254)
  status     SummaryDispatchItemStatus
  errorCode  String?                   @db.VarChar(60)
  message    String?                   @db.VarChar(300)
  createdAt  DateTime                  @default(now()) @db.Timestamptz(3)

  dispatch SummaryDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  person   Person          @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([dispatchId])
  @@index([personId])
}

enum SummaryChannel {
  EMAIL
}

enum SummaryDispatchStatus {
  RUNNING
  DONE
  /// A função parou no meio (queda, tempo esgotado): liberado pelo próximo envio do mês.
  INTERRUPTED
}

enum SummaryDispatchItemStatus {
  SENT
  SKIPPED_NO_EMAIL
  FAILED
}

/// De quem é a despesa: ainda sem escolha (só no cartão), compartilhada (dividida entre as pessoas
/// ativas) ou individual (personId).
enum ExpenseSplit {
  PENDING
  SHARED
  PERSONAL
}

/// De onde veio a despesa do cartão: upload de fatura, sincronização com a Pluggy ou "Adicionar compra".
enum CardExpenseOrigin {
  UPLOAD
  SYNC
  MANUAL
}

enum CardBank {
  NUBANK
  C6
  NEON
}

enum Role {
  ADMIN
  USER
}
